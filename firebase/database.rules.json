{
  "rules": {
    ".read": false,
    ".write": false,
    "g": {
      "$gid": {
        ".read": "auth != null && $gid.length === 32",
        "m": {
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || (!newData.exists() && data.child('t').val() < now - 1800000))",
            ".validate": "!newData.exists() || (newData.hasChildren(['p', 't']) && newData.child('t').val() <= now && newData.child('p').val().length <= 4000 && (!newData.child('r').exists() || newData.child('r').val().length <= 12000))"
          }
        },
        "v": {
          ".indexOn": ["t"],
          "$id": {
            ".write": "auth != null && ((!data.exists() && newData.child('from').val() === auth.uid) || (data.exists() && !newData.exists() && (data.child('from').val() === auth.uid || data.child('t').val() < now - 120000)))",
            ".validate": "!newData.exists() || (newData.hasChildren(['from', 't', 'd']) && newData.child('t').val() <= now && newData.child('d').val().length <= 200000)"
          }
        }
      }
    }
  }
}
